pipeline {

    agent any

    environment {
        DEPLOY_DIR = "/opt/contactflow"
    }

    stages {

        stage('Update Code') {
            steps {
                sh '''
                cd $DEPLOY_DIR
                git pull origin main
                '''
            }
        }

        stage('Build') {
            steps {
                sh '''
                cd $DEPLOY_DIR
                docker compose build
                '''
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                cd $DEPLOY_DIR

                docker compose down

                docker compose up -d
                '''
            }
        }

        stage('Verify') {
            steps {
                sh 'docker ps'
            }
        }
    }
}
